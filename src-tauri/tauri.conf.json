{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PokeNotes",
  "version": "0.4.3",
  "identifier": "ch.kaidoh.pokenotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PokeNotes",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Kai-Doh/PokeNotes/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNTg2QTY3NTc0MEQ3RDEKUldUUjEwQlhaMnBZc3M5VTdyRWFTVUVlQzB3cWFLa0J2MG5QY25uckoweldndGVJZGsrYjRLY2gK"
    }
  }
}
