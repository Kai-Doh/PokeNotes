# Signing keys (Tauri updater key + Android release keystore) - NEVER commit
# private key material. Everything in here is secret except the .pub file.
.tauri-keys/*
!.tauri-keys/*.pub

# Rust build output
src-tauri/target
sync-server/target

# sync-server runtime SQLite db (local dev only -- real data lives on the VPS volume)
sync-server/data/

# App data / seed db working copy
*.db-journal

# Raw PokeAPI CSV cache for the data pipeline script - regenerable, not product data
scripts/.cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
